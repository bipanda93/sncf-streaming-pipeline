# --- SNCF API ---
# Laisser vide -> le client bascule automatiquement en mode mock (données synthétiques)
SNCF_API_TOKEN=

# --- Kafka (local, Docker Compose) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Kafka (Azure Event Hubs, à activer plus tard) ---
# KAFKA_BOOTSTRAP_SERVERS=<namespace>.servicebus.windows.net:9093
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=$ConnectionString
# KAFKA_SASL_PASSWORD=<connection string Event Hubs complète>

KAFKA_TOPIC_RAW=sncf-raw
POLL_INTERVAL_SECONDS=300

# --- Delta Lake / Streaming ---
DELTA_BRONZE_PATH=/tmp/delta/bronze/sncf_raw
CHECKPOINT_BRONZE_PATH=/tmp/delta/checkpoints/bronze_sncf_raw
